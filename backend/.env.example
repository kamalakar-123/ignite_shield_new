# ==============================================================================
# IGNITE SHIELD BACKEND CONFIGURATION
# Copy this file to .env and replace placeholders with your credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Database Configuration
# Local SQLite default (Zero cost, no external database service required):
DATABASE_URL=sqlite:///./ignite_shield.db
# Or PostgreSQL for cloud deployment (e.g. Supabase, Neon, or AWS RDS):
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@localhost:5432/ignite_shield

# Security & Authentication Keys
JWT_SECRET_KEY=change_this_to_a_random_32_character_secret_key
DEVICE_API_KEY=your_esp32_device_shared_secret_token
ADMIN_API_KEY=your_admin_secret_api_key

# External Weather API (Open-Meteo free high-resolution meteorological API)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Station Default Coordinates (WGS-84)
STATION_DEFAULT_LAT=12.2958
STATION_DEFAULT_LON=76.6394

# AI Assistant Configuration
# Options for AI_PROVIDER: auto | gemini | openai | offline
AI_PROVIDER=auto
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# Gmail SMTP Email Notification Configuration (Port 587 STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_sender_account@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
ALERT_EMAIL=command_center_officer@example.com

# Twilio SMS & WhatsApp Configuration
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_SMS_FROM=+15005550006
TWILIO_SMS_TO=+1234567890
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1234567890
TWILIO_WHATSAPP_CONTENT_SID=

# Alert Rules & Rate Limiting
ALERT_COOLDOWN_MINUTES=30
FIRE_RISK_TRIGGER_LEVEL=HIGH
