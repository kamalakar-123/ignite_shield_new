# ==============================================================================
# IGNITE SHIELD FRONTEND CONFIGURATION
# Copy this file to .env or .env.local
# ==============================================================================

# Backend API Base URL (Local or AWS CloudFront/App Runner endpoint)
VITE_API_URL=http://localhost:8000

# Admin API Key for manual test alert triggers (matches backend ADMIN_API_KEY)
VITE_ADMIN_API_KEY=your_admin_secret_api_key

# Default Regional Center Coordinates
VITE_WEATHER_LATITUDE=12.2958
VITE_WEATHER_LONGITUDE=76.6394
